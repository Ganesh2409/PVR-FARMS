# Copy to .env and edit. NEVER commit .env.
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL (required; SQLite is not supported) ---
# Dedicated, non-superuser role "mango_app" - see README "PostgreSQL setup".
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://mango_app:Ganesh24%40%40@localhost:5432/mango_farm
# Used only by the test-suite (the database name MUST end in _test; its tables are emptied on every run):
TEST_DATABASE_URL=postgresql+psycopg://mango_app:Ganesh24%40%40@localhost:5432/mango_farm_test

# First admin account (created at startup only if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Public HTTPS URL of this server. REQUIRED for online payments (pay links, Cashfree return/notify URLs)
# and for WhatsApp product images. Example: https://farm.example.com or your tunnel URL.
PUBLIC_BASE_URL=
ENABLE_SIMULATOR=true
AUTO_MIGRATE=true
CONVERSATION_TIMEOUT_MINUTES=60

# --- Cashfree Payment Gateway (see README "Cashfree Sandbox") ---
# cashfree = real gateway (sandbox or production per CASHFREE_ENV).  mock = development-only fake gateway.
PAYMENT_PROVIDER=cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# Leave empty to use the default documented by Cashfree (2026-01-01).
CASHFREE_API_VERSION=
PAYMENT_EXPIRY_MINUTES=30
# false: a failed attempt keeps the stock held until expiry so the customer can retry on the same link.
# true : a failed attempt cancels the order and releases the stock immediately.
PAYMENT_RELEASE_ON_FAILED_ATTEMPT=false

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Approved template used for business-initiated messages outside the 24h window.
# Body must have 3 variables: {{1}} customer name, {{2}} order id, {{3}} status message.
WHATSAPP_TEMPLATE_ORDER_UPDATE=
# Development only: accept webhooks without a valid signature. Never true in production.
ALLOW_UNSIGNED_WEBHOOKS=false
